<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>LeetCode FAAAAME</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      width: 280px;
      background: #0d0d1a;
      color: #fff;
      font-family: 'Space Mono', 'Courier New', monospace;
      overflow: hidden;
    }

    .header {
      background: linear-gradient(135deg, #1a0a0a, #2a0f0f);
      border-bottom: 2px solid #ff4444;
      padding: 20px;
      text-align: center;
      position: relative;
    }

    .trombone {
      font-size: 48px;
      display: block;
      animation: trombone 1.5s ease-in-out infinite;
      transform-origin: bottom center;
    }

    @keyframes trombone {
      0%, 100% { transform: rotate(-5deg); }
      50%       { transform: rotate(5deg) scale(1.05); }
    }

    h1 {
      font-size: 22px;
      color: #ff4444;
      letter-spacing: 4px;
      margin-top: 8px;
      text-shadow: 0 0 20px rgba(255,68,68,0.5);
    }

    .subtitle {
      font-size: 10px;
      color: #666;
      margin-top: 4px;
      letter-spacing: 1px;
    }

    .body {
      padding: 20px;
    }

    .status-card {
      background: #1a1a2e;
      border: 1px solid #2a2a4a;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 16px;
    }

    .status-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }

    .status-row:last-child { margin-bottom: 0; }

    .status-label {
      font-size: 10px;
      color: #666;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .status-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: #44ff88;
      box-shadow: 0 0 8px #44ff88;
      animation: pulse 2s ease infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%       { opacity: 0.6; transform: scale(0.8); }
    }

    .status-value {
      font-size: 11px;
      color: #44ff88;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .triggers-list {
      background: #0d0d1a;
      border: 1px solid #2a2a2a;
      border-radius: 8px;
      padding: 12px;
      margin-bottom: 16px;
    }

    .triggers-title {
      font-size: 10px;
      color: #555;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .trigger-item {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
      font-size: 11px;
      color: #ccc;
    }

    .trigger-item:last-child { margin-bottom: 0; }

    .trigger-icon { font-size: 14px; }

    .test-btn {
      width: 100%;
      background: linear-gradient(135deg, #ff4444, #cc2222);
      border: none;
      border-radius: 10px;
      color: white;
      font-family: 'Space Mono', monospace;
      font-size: 13px;
      font-weight: bold;
      letter-spacing: 2px;
      padding: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      text-transform: uppercase;
    }

    .test-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255, 68, 68, 0.4);
    }

    .test-btn:active {
      transform: translateY(0);
    }

    .footer {
      padding: 12px 20px;
      text-align: center;
      font-size: 10px;
      color: #333;
      border-top: 1px solid #1a1a2e;
    }
  </style>
</head>
<body>

  <div class="header">
    <span class="trombone">🎺</span>
    <h1>FAAAAME</h1>
    <div class="subtitle">FOR LEETCODE FAILURES</div>
  </div>

  <div class="body">

    <div class="status-card">
      <div class="status-row">
        <span class="status-label">Extension Status</span>
        <span class="status-value">
          <span class="status-dot"></span>
          ACTIVE
        </span>
      </div>
      <div class="status-row">
        <span class="status-label">Watching</span>
        <span class="status-value" style="color: #aaa; font-size: 10px;">leetcode.com</span>
      </div>
    </div>

    <div class="triggers-list">
      <div class="triggers-title">🔔 Triggers sound on</div>
      <div class="trigger-item"><span class="trigger-icon">❌</span> Wrong Answer</div>
      <div class="trigger-item"><span class="trigger-icon">⏱️</span> Time Limit Exceeded</div>
      <div class="trigger-item"><span class="trigger-icon">💥</span> Runtime Error</div>
      <div class="trigger-item"><span class="trigger-icon">🔧</span> Compile Error</div>
      <div class="trigger-item"><span class="trigger-icon">🧠</span> Memory Limit Exceeded</div>
    </div>

    <button class="test-btn" id="testBtn">▶ TEST SOUND</button>

  </div>

  <div class="footer">Made for leetcode grinders who need humbling</div>

  <script src="popup.js"></script>
</body>
</html>
